# Copie para .env na raiz antes do "docker compose up --build"
# gere cada um com: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
MP_WEBHOOK_SECRET=
SEED_DEMO=1

# Mercado Pago OAuth (opcional): crie um app em mercadopago.com.br/developers e cadastre
# como Redirect URI:  <PUBLIC_API_URL>/integrations/mercadopago/oauth/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# MP_REDIRECT_URI=      # só se precisar sobrescrever o padrão acima
# MP_OAUTH_PKCE=true
# Para onde o usuário volta depois de autorizar (padrão: PUBLIC_API_URL)
WEB_URL=http://localhost:8080

# Mensalidade: conta Mercado Pago da plataforma (webhook: <PUBLIC_API_URL>/billing/webhook/mercadopago, evento "Pagamentos")
# E-mails (separados por vírgula) com acesso ao painel de administração da plataforma
PLATFORM_ADMIN_EMAILS=
PLATFORM_MP_ACCESS_TOKEN=
BILLING_MP_WEBHOOK_SECRET=
